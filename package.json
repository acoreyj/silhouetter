{
	"name": "silhouetter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
