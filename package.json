		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@cadit-app/potrace-ts": "^1.3.0",
		"@doodle3d/clipper-js": "^1.0.11",
		"@imgly/background-removal": "^1.7.0",
		"bwip-js": "^4.11.4",
		"konva": "^10.5.0",
